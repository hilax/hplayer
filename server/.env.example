# 访问密码，必填。公网部署时请用长密码
HPLAYER_PASSWORD=change-me-please

# 监听端口
PORT=8787

# 115 请求使用的 UA，一般不用改
# HPLAYER_UA=Mozilla/5.0 ...

# ffmpeg / ffprobe 路径，未加入 PATH 时填写绝对路径
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe

# 数据目录（存放 115 Cookie、会话密钥），默认 ./data
# HPLAYER_DATA=./data
